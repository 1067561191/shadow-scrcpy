# 默认注释了源码镜像以提高 apt update 速度，如有需要可自行取消注释
deb http://mirrors4.tuna.tsinghua.edu.cn/ubuntu/ resolute main restricted universe multiverse
# deb-src http://mirrors4.tuna.tsinghua.edu.cn/ubuntu/ resolute main restricted universe multiverse
deb http://mirrors4.tuna.tsinghua.edu.cn/ubuntu/ resolute-updates main restricted universe multiverse
# deb-src http://mirrors4.tuna.tsinghua.edu.cn/ubuntu/ resolute-updates main restricted universe multiverse
deb http://mirrors4.tuna.tsinghua.edu.cn/ubuntu/ resolute-backports main restricted universe multiverse
# deb-src http://mirrors4.tuna.tsinghua.edu.cn/ubuntu/ resolute-backports main restricted universe multiverse

# 以下安全更新软件源为官方源配置
deb http://security.ubuntu.com/ubuntu/ resolute-security main restricted universe multiverse
# deb-src http://security.ubuntu.com/ubuntu/ resolute-security main restricted universe multiverse

# 预发布软件源，不建议启用
# deb http://mirrors4.tuna.tsinghua.edu.cn/ubuntu/ resolute-proposed main restricted universe multiverse
# # deb-src http://mirrors4.tuna.tsinghua.edu.cn/ubuntu/ resolute-proposed main restricted universe multiverse